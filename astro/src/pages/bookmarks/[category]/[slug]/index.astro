---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import SiteLayout from "../../../../layouts/SiteLayout.astro";
import ConsentComments from "../../../../components/ConsentComments.astro";
import { bookmarkDetailParams, bookmarkDetailPath } from "../../../../lib/bookmark-path.ts";
import { bookmarkNeighborMap, type BookmarkAdjacency } from "../../../../lib/bookmark-neighbors.ts";
import { categoryBySection, bookmarkCategoryPath } from "../../../../lib/bookmark-categories.ts";
import { publicBookmarkUrl } from "../../../../lib/bookmark-public-url.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("bookmarks", ({ id, data }) =>
    id !== "_index" && !id.endsWith("/_index") && !data.draft
  );
  const neighbors = bookmarkNeighborMap(entries.map(entry => ({
    id: entry.id, title: entry.data.title,
    date: entry.data.date?.toISOString().slice(0,10) ?? "",
  })));
  return entries.map((entry) => ({
    params: bookmarkDetailParams(entry.id),
    props: { entry, adjacency: neighbors.get(entry.id) ?? {} },
  }));
}) satisfies GetStaticPaths;

const { entry, adjacency } = Astro.props as { entry: CollectionEntry<"bookmarks">; adjacency: BookmarkAdjacency };
const section = entry.id.split("/")[0];
const category = categoryBySection(section);
if (!category) throw new Error(`Unknown bookmark category in ${entry.id}`);

const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const externalUrl = publicBookmarkUrl(entry.data.link ?? "");
const date = entry.data.date?.toISOString().slice(0, 10) ?? "";
const categoryPath = bookmarkCategoryPath(category.slug);
---
<SiteLayout title={entry.data.title} description={`${category.label} bookmark`}>
  <nav aria-label="Bookmark context" class="breadcrumb">
    <a href="/bookmarks/">Bookmarks</a>
    <span aria-hidden="true">/</span>
    <a href={categoryPath}>{category.label}</a>
  </nav>
  <article class="bookmark-detail">
    <h1>{entry.data.title}</h1>
    {date && <p class="meta"><time datetime={date}>{date}</time></p>}
    {externalUrl && <p><a href={externalUrl} target="_blank" rel="noopener noreferrer">Open original link</a></p>}
    {entry.data.comments && <p class="bookmark-comment">{entry.data.comments}</p>}
    {(entry.data.tags?.length ?? 0) > 0 && <ul class="bookmark-tags" aria-label="Bookmark tags">
      {entry.data.tags.map(tag => <li>{tag}</li>)}
    </ul>}
    {hasBody && <section class="bookmark-notes" aria-label="Bookmark notes"><Content /></section>}
  </article>
  {(adjacency.previous || adjacency.next) && <nav class="bookmark-neighbors" aria-label="Browse nearby bookmarks">
    {adjacency.previous && <a rel="prev" href={bookmarkDetailPath(adjacency.previous.id)}>Previous: {adjacency.previous.title}</a>}
    {adjacency.next && <a rel="next" href={bookmarkDetailPath(adjacency.next.id)}>Next: {adjacency.next.title}</a>}
  </nav>}
  <ConsentComments />
</SiteLayout>
<style>
  .breadcrumb { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; color: var(--muted); }
  .bookmark-detail { margin: 2rem 0; max-width: 65ch; overflow-wrap: anywhere; }
  .bookmark-detail h1 { line-height: 1.2; }
  .meta { color: var(--muted); }
  .bookmark-comment { white-space: pre-wrap; }
  .bookmark-tags { display: flex; flex-wrap: wrap; list-style: none; padding: 0; gap: .4rem; }
  .bookmark-tags li { border: 1px solid var(--border); border-radius: 0; padding: .2rem .5rem; }
  .bookmark-notes { margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  .bookmark-neighbors { max-width: 70rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .8rem 1.5rem; margin: 1.5rem 0 2rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .bookmark-neighbors a { overflow-wrap: anywhere; flex: 1 1 min(100%, 20rem); }
</style>
