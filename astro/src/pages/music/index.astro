---
import SiteLayout from "../../layouts/SiteLayout.astro";
import MediaTable from "../../components/MediaTable.astro";
import { loadMedia } from "../../lib/media-store.ts";
const entries=await loadMedia("music");
---
<SiteLayout title="Music" description="A personal collection of music, with optional ratings and independent links.">
  <h1>Music</h1>
  <p><a href="/new-media/">Add a music release</a> through a reviewed GitHub pull request.</p>
  <MediaTable kind="music" entries={entries}/>
</SiteLayout>
