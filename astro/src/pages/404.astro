---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Page not found" description="Page not found." errorPage>
  <section class="missing-page">
    <h1>Page not found</h1>
    <p>That page is not available.</p>
    <nav aria-label="Page not found navigation" class="missing-links">
      <a href="/">Home</a>
      <a href="/bookmarks/">Bookmarks</a>
      <a href="/search/">Search</a>
      <a href="/sh/" lang="sh">Početna (SH)</a>
    </nav>
  </section>
</SiteLayout>
<style>
  .missing-page { max-width: 46rem; padding: 3rem 0; }
  .missing-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
</style>
