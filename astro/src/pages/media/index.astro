---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { loadMedia } from "../../lib/media-store.ts";
const all=await loadMedia();
const links=[
  {kind:"films",title:"Films",description:"Films and ratings."},
  {kind:"tv",title:"TV series",description:"Series and ratings."},
  {kind:"music",title:"Music",description:"Albums and ratings."},
] as const;
---
<SiteLayout title="Media" description="Films, TV and music.">
  <section class="media-home">
    <h1>Media</h1>
    <p><a class="button-link" href="/new-media/">Add media</a></p>
    <div class="media-groups">
      {links.map(link=><article>
        <h2><a href={"/"+link.kind+"/"}>{link.title}</a></h2>
        <p>{link.description}</p>
        <p>{all.filter(entry=>entry.kind===link.kind).length} records</p>
      </article>)}
    </div>
  </section>
</SiteLayout>
<style>
.media-home{max-width:68rem}.media-home>p{max-width:65ch}
.media-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:1rem;margin:2rem 0}
.media-groups article{background:var(--surface);border:1px solid var(--border);border-radius: 0;padding:1.1rem}
.media-groups h2{margin-top:0}.media-groups p{color:var(--muted)}
</style>
