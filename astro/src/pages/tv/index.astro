---
import SiteLayout from "../../layouts/SiteLayout.astro";
import MediaTable from "../../components/MediaTable.astro";
import { loadMedia } from "../../lib/media-store.ts";
const entries=await loadMedia("tv");
---
<SiteLayout title="TV series" description="A personal collection of tv series, with optional ratings and independent links.">
  <h1>TV series</h1>
  <p><a href="/new-media/">Add a TV series</a> through a reviewed GitHub pull request.</p>
  <MediaTable kind="tv" entries={entries}/>
</SiteLayout>
