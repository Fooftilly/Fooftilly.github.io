---
import SiteLayout from "../../layouts/SiteLayout.astro";
import MediaTable from "../../components/MediaTable.astro";
import { loadMedia } from "../../lib/media-store.ts";
const entries=await loadMedia("tv");
---
<SiteLayout title="TV series" description="Series and ratings.">
  <h1>TV series</h1>
  <p><a href="/new-media/?kind=tv">Add a TV series</a>.</p>
  <MediaTable kind="tv" entries={entries}/>
</SiteLayout>
