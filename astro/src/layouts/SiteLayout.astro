---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  rssHref?: string;
  lang?: "en" | "sr";
  languageAlternate?: string;
}

const { title, description = "Bookmarks, notes, projects and collections.", rssHref, lang = "en", languageAlternate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/avatar-full.webp", Astro.site);
const alternateUrl = languageAlternate ? new URL(languageAlternate, Astro.site).href : undefined;
const languageLabel = lang === "sr" ? "English" : "Srpski";
---
<!doctype html>
<html lang={lang === "sr" ? "sr-Latn" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Nikola Perović</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nikola Perović" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nikola Perović" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {alternateUrl && <link rel="alternate" hreflang={lang === "sr" ? "en" : "sr-Latn"} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={lang === "sr" ? "sr-Latn" : "en"} href={canonical.toString()} />}
    {rssHref && <link rel="alternate" type="application/rss+xml" title={title} href={rssHref} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="site-brand" href={lang === "sr" ? "/sr/" : "/"}>Nikola Perović</a>
        <div class="site-links">
          <a href={lang === "sr" ? "/sr/posts/" : "/posts/"}>{lang === "sr" ? "Objave" : "Posts"}</a>
          <a href="/bookmarks/">{lang === "sr" ? "Sačuvani linkovi" : "Bookmarks"}</a>
          <a href={lang === "sr" ? "/sr/search/" : "/search/"}>{lang === "sr" ? "Pretraga" : "Search"}</a>
          <a href="/new-bookmark/">{lang === "sr" ? "Dodaj link" : "Add bookmark"}</a>
          <a href={lang === "sr" ? "/sr/about/" : "/about/"}>{lang === "sr" ? "O sajtu" : "About"}</a>
          {languageAlternate && <a href={languageAlternate} lang={lang === "sr" ? "en" : "sr-Latn"} hreflang={lang === "sr" ? "en" : "sr-Latn"}>{languageLabel}</a>}
        </div>
      </nav>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{lang === "sr" ? "Lični linkovi i bilješke" : "Personal links and notes"} · <a href="https://github.com/Fooftilly">GitHub</a></p>
    </footer>
  </body>
</html>
