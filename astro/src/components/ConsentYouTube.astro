---
interface Props { videoId: string; title: string }
const {videoId,title}=Astro.props;
---
<section class="youtube-consent" aria-labelledby="youtube-heading"
  data-youtube-consent data-youtube-video-id={videoId} data-youtube-title={title}>
  <h2 id="youtube-heading">Watch on YouTube</h2>
  <p>The video is not loaded until you choose. Playing it connects to YouTube,
    which may receive your IP address and set cookies, even in privacy-enhanced mode.</p>
  <button type="button" data-load-youtube aria-controls="youtube-player" aria-expanded="false">
    Load YouTube video
  </button>
  <div id="youtube-player" data-youtube-container></div>
</section>
<script>
  import { mountConsentYouTube } from "../lib/youtube-embed.ts";
  mountConsentYouTube();
</script>
<style>
  .youtube-consent{margin:1.5rem 0 2rem;max-width:70rem}
  .youtube-consent p{color:var(--muted);max-width:68ch}
  .youtube-consent button{font:inherit;min-height:2.75rem;padding:.65rem 1rem;
    border:1px solid var(--border);border-radius:0;background:var(--surface);
    color:var(--foreground);cursor:pointer}
  .youtube-consent button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  [data-youtube-container]{margin-top:1rem}
  [data-youtube-container] iframe{display:block;width:100%;height:auto;
    aspect-ratio:16 / 9;border:0}
</style>
