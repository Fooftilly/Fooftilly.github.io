---
import { loadBookmarks } from "../lib/bookmark-data.ts";
import { homepageSummary } from "../lib/homepage.ts";
import { bookmarkCategoryPath, bookmarkCategoryDisplayLabel } from "../lib/bookmark-categories.ts";

interface Props { lang: "en" | "sh" }
const { lang } = Astro.props;
const sh = lang === "sh";
const { count, recent, categories } = homepageSummary(await loadBookmarks());
---
<section class="homepage-collections" aria-labelledby="homepage-categories">
  <div class="section-heading">
    <div>
      <h2 id="homepage-categories">{sh ? "Kategorije" : "Categories"}</h2>
    </div>
    <a href="/bookmarks/">{sh ? "Svi linkovi" : "All bookmarks"} ({count})</a>
  </div>
  <ul class="category-grid">
    {categories.map((category) => <li>
      <a href={bookmarkCategoryPath(category.slug)}>
        <span class="category-label">{sh ? category.labelSh : category.label}</span>
        <span class="category-count">{category.count}</span>
      </a>
    </li>)}
  </ul>
</section>
<section class="recent-bookmarks" aria-labelledby="homepage-recent">
  <div class="section-heading">
    <div>
      <h2 id="homepage-recent">{sh ? "Nedavno sačuvano" : "Recently saved"}</h2>
    </div>
    <a href={sh ? "/sh/search/" : "/search/"}>{sh ? "Pretraži" : "Search"}</a>
  </div>
  <ul class="recent-grid">
    {recent.map((item) => <li>
      {item.url
        ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a>
        : <strong>{item.title}</strong>}
      <p>{bookmarkCategoryDisplayLabel(item.category, lang)} {item.date && <><span aria-hidden="true"> · </span><time datetime={item.date}>{item.date}</time></>}</p>
    </li>)}
  </ul>
</section>
<style>
  .homepage-collections, .recent-bookmarks { margin: 1.5rem 0 3.5rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: .75rem; margin: 1rem 0; }
  .section-heading h2 { margin: .2rem 0; font-size: clamp(1.3rem, 3vw, 1.75rem); }
  .category-grid, .recent-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .category-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .category-grid a { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: 0; text-decoration: none; min-height: 4rem; }
  .category-grid a:hover, .category-grid a:focus-visible { border-color: var(--accent); }
  .category-label { font-weight: 650; color: var(--foreground); }
  .category-count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .recent-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .recent-grid li { padding: 1.1rem; border: 1px solid var(--border); border-radius: 0; min-width: 0; }
  .recent-grid a, .recent-grid strong { font-weight: 650; overflow-wrap: anywhere; }
  .recent-grid p { color: var(--muted); font-size: .84rem; margin: .45rem 0 0; }
  @media (prefers-reduced-motion: no-preference) {
    .category-grid a { transition: border-color .15s ease; }
  }
</style>
