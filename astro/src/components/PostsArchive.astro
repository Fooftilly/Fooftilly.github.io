---
import { getEntry } from "astro:content";
interface Props { lang: "en" | "sh" }
const { lang } = Astro.props;
const key = lang === "sh" ? "posts.sh" : "posts";
const entry = await getEntry("sitePages", key);
if (!entry) throw new Error(`Missing original posts archive metadata: ${key}`);
const title = entry.data.title;
---
<section class="posts-archive" aria-label={title}>
  <h1>{title}</h1>
  <p>{lang === "sh"
    ? "Još nema objava."
    : "No posts yet."}</p>
  <a href="/bookmarks/">{lang === "sh" ? "Pogledaj linkove" : "Browse bookmarks"}</a>
</section>
<style>
  .posts-archive { max-width: 65ch; padding: 1.5rem 0; }
</style>
