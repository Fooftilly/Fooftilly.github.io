---
import { getCollection } from "astro:content";
import { sortProjects, projectPath } from "../lib/project-catalog.ts";
import { projectStatusLabel, projectTagHref } from "../lib/project-search.ts";
interface Props { limit?: number; lang?: "en"|"sh" }
const {limit,lang="en"}=Astro.props;
const sh=lang==="sh";
const allProjects=sortProjects(await getCollection("projects"));
const projects=limit===undefined ? allProjects : allProjects.slice(0,limit);
---
<ul class="project-cards">
  {projects.map(({id,data})=><li class="project-card">
    <h3><a href={projectPath(id)}>{data.title}</a></h3>
    <p>{sh && data.summarySh ? data.summarySh : data.summary}</p>
    {data.status && <p class="project-status">{projectStatusLabel(data.status, lang)}</p>}
    <ul class="project-tags" aria-label={data.title+(sh?" — tehnologije":" technologies")}>
      {data.tags.map(tag=><li><a href={projectTagHref(tag,lang)}>{tag}</a></li>)}
    </ul>
    <p class="project-source">
      <a href={data.repository} rel="noopener noreferrer" aria-label={`${sh?"Izvorni kod":"Source code"}: ${data.title}`}>
        {sh?"Izvorni kod":"Source code"}
      </a>
    </p>
  </li>)}
</ul>
<style>
.project-cards{list-style:none;padding:0;margin:1rem 0 2rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem}
.project-card{background:var(--surface);border:1px solid var(--border);padding:1.1rem;min-width:0;border-radius:0}
.project-card h3{font-size:1.16rem;margin:0 0 .6rem;overflow-wrap:anywhere}
.project-card p{margin:.45rem 0;line-height:1.5}
.project-status{color:var(--muted);font-size:.9rem}
.project-source{margin-top:.9rem}
.project-tags{display:flex;flex-wrap:wrap;list-style:none;gap:.4rem;margin:1rem 0 0;padding:0}
.project-tags li{font-size:.8rem;border:1px solid var(--border);padding:.2rem .45rem;border-radius:0}
.project-tags a{color:inherit;text-decoration:underline;text-underline-offset:.18em}
</style>
