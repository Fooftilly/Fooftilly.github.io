---
import type { MediaKind, StoredMedia } from "../lib/media-model.ts";
interface Props { kind:MediaKind; entries:StoredMedia[] }
const {kind,entries}=Astro.props;
const title=kind==="music"?"Music":kind==="films"?"Films":"TV series";
const creatorLabel=kind==="music"?"Artist":kind==="films"?"Director":"Creator";
---
<section aria-label={title+" collection"} class="media-collection" data-media-collection>
  <p class="media-description">
    Your independently maintained media collection. External links are optional references,
    not dependencies. Entries are reviewed in Git before publication.
  </p>
  {entries.length===0?(
    <p class="empty-media" role="status">No {title.toLowerCase()} entries have been published yet.</p>
  ):(
    <>
      <div class="media-controls" data-media-controls hidden>
        <label for={"media-search-"+kind}>Search {title.toLowerCase()}
          <input id={"media-search-"+kind} type="search" data-media-search autocomplete="off" placeholder="Title, creator, notes..." />
        </label>
        <div class="sort-controls" role="group" aria-label={"Sort "+title.toLowerCase()}>
          <button type="button" data-media-sort="rating" aria-pressed="true">Top rated</button>
          <button type="button" data-media-sort="title" aria-pressed="false">Title A–Z</button>
          <button type="button" data-media-sort="year" aria-pressed="false">Newest</button>
        </div>
        <p data-media-count role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    <div class="media-scroll">
      <table>
        <caption>{entries.length} {title.toLowerCase()} entries</caption>
        <thead>
          <tr><th scope="col">Title</th><th scope="col">{creatorLabel}</th><th scope="col">Year</th>
              <th scope="col">My rating</th><th scope="col">Status</th><th scope="col">Links</th></tr>
        </thead>
        <tbody>
          {entries.map(item=>(
            <tr data-media-row data-title={item.title} data-year={item.year??""} data-rating={item.rating??""} data-id={item.id}>
              <th scope="row">{item.title}{item.notes&&<details><summary>Notes</summary><p class="notes">{item.notes}</p></details>}</th>
              <td>{item.creator??"—"}</td>
              <td>{item.year??"—"}</td>
              <td aria-label={item.rating!==undefined?item.rating+" out of 5 stars":"Not rated"}>{item.rating!==undefined?item.rating.toFixed(1)+" / 5":"—"}</td>
              <td>{item.status??"—"}</td>
              <td>
                {item.links?.length?item.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>):"—"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p data-media-no-results class="media-no-results" role="status" hidden>No matching {title.toLowerCase()} entries. Try another search.</p>
    </>
  )}
</section>
<script>
  import { initializeMediaTables } from "../scripts/media-table.ts";
  initializeMediaTables();
</script>
<style>
  .media-collection{margin-top:1.25rem;max-width:76rem}
  .media-description{max-width:60rem;color:var(--muted)}
  .empty-media{padding:1.5rem;background:var(--surface);border:1px solid var(--border);border-radius:.65rem}
  .media-controls{display:flex;flex-wrap:wrap;align-items:end;gap:.75rem 1.25rem;margin:1rem 0}
  .media-controls[hidden],.media-no-results[hidden],tbody tr[hidden]{display:none}
  .media-controls label{display:grid;gap:.25rem;font-weight:600;min-width:min(100%,18rem)}
  .media-controls input{padding:.55rem .7rem;border:1px solid var(--border);border-radius:.4rem;background:var(--surface);color:var(--foreground);font:inherit;width:100%}
  .sort-controls{display:flex;flex-wrap:wrap;gap:.4rem}
  .sort-controls button{padding:.5rem .7rem;border:1px solid var(--border);border-radius:.4rem;background:var(--surface);color:var(--foreground);font:inherit;cursor:pointer}
  .sort-controls button[aria-pressed="true"]{border-color:var(--accent);color:var(--accent);font-weight:700}
  [data-media-count]{color:var(--muted);margin:.3rem 0}
  .media-no-results{color:var(--muted)}
  .media-scroll{overflow-x:auto;margin:1rem 0 2rem}
  table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
  caption{text-align:start;color:var(--muted);padding:.6rem 0}
  th,td{padding:.8rem .65rem;text-align:start;vertical-align:top;border-bottom:1px solid var(--border)}
  tbody th{max-width:25rem;overflow-wrap:anywhere}
  td{overflow-wrap:anywhere}
  td:last-child a{display:block;min-width:4rem;margin-bottom:.35rem}
  details{margin-top:.5rem;font-size:.88rem;font-weight:400}
  details summary{cursor:pointer;color:var(--accent)}
  .notes{max-width:55ch;white-space:pre-wrap}
  @media(max-width:700px){th,td{padding:.65rem .45rem;font-size:.88rem}}
</style>
