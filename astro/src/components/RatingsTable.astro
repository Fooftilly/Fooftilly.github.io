---
import type { RatingsCatalog, RatingsKind } from "../lib/ratings.ts";
interface Props {
  kind: RatingsKind;
  catalog: RatingsCatalog;
}
const { kind, catalog } = Astro.props;
const isMusic = kind === "music";
const label = isMusic ? "Music" : "Film";
const column = isMusic ? "Artist" : "Director";
const items = catalog.items;
---
<section class="ratings-collection" aria-label={label + " ratings"}>
  <p class="rating-context">Personal ratings on a 5-star scale, sourced from {catalog.source}. Only explicitly rated entries are shown.</p>
  {items.length === 0 ? (
    <p class="ratings-empty" role="status">No {isMusic ? "music" : "film"} ratings have been published yet.</p>
  ) : (
    <div class="ratings-scroll">
      <table>
        <caption>{items.length} {isMusic ? "music releases" : "films"} rated, sorted by highest rating</caption>
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">{column}</th>
            <th scope="col">Year</th>
            <th scope="col">My rating</th>
          </tr>
        </thead>
        <tbody>
          {items.map((item) => (
            <tr>
              <th scope="row">
                {item.url ? <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}
              </th>
              <td>{item.artist ?? "—"}</td>
              <td>{item.year ?? "—"}</td>
              <td class="rating-value" aria-label={item.rating + " out of 5 stars"}>{item.rating.toFixed(1)} / 5</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</section>
<style>
  .ratings-collection { margin-top: 1rem; max-width: 75rem; }
  .rating-context { color: var(--muted); max-width: 65ch; }
  .ratings-empty { padding: 2rem 1.25rem; border: 1px solid var(--border); border-radius: .65rem; background: var(--surface); }
  .ratings-scroll { margin: 1.25rem 0 2rem; max-width: 100%; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: start; padding: .6rem 0; color: var(--muted); }
  th, td { padding: .85rem .6rem; text-align: start; border-bottom: 1px solid var(--border); vertical-align: top; }
  thead th { background: var(--surface); font-weight: 700; }
  tbody th { font-weight: 600; max-width: 30rem; overflow-wrap: anywhere; }
  td { overflow-wrap: anywhere; }
  .rating-value { white-space: nowrap; font-weight: 650; }
  @media (max-width: 600px) {
    th, td { padding: .75rem .4rem; font-size: .9rem; }
  }
</style>
