---
import { getCollection } from "astro:content";
import { sortProjects } from "../lib/project-catalog.ts";
import ProjectBrowser from "./ProjectBrowser.vue";

interface Props { lang?: "en" | "sh" }
const { lang = "en" } = Astro.props;
const projects = sortProjects(await getCollection("projects")).map(({ id, data }) => ({
  id,
  title: data.title,
  summary: data.summary,
  summarySh: data.summarySh,
  repository: data.repository,
  tags: data.tags,
  status: data.status,
}));
---
<ProjectBrowser projects={projects} lang={lang} client:load />
<noscript>
  <p class="project-nojs-notice">
    {lang === "sh"
      ? "Pretraga i filtriranje oznaka zahtijevaju JavaScript. Svi objavljeni projekti prikazani su ispod."
      : "Search and tag filtering require JavaScript. All published projects remain listed below."}
  </p>
</noscript>
<style>
.project-nojs-notice{padding:.7rem 0;color:var(--muted)}
</style>
