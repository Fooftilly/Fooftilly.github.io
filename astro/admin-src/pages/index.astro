---
import { getCollection } from "astro:content";
import AdminLayout from "../layouts/AdminLayout.astro";
import NewBookmark from "../../src/components/NewBookmark.vue";
import { parseBookmarkUrl } from "../../src/lib/bookmark-draft.ts";

// Include draft filenames to prevent collisions, but never render draft URLs.
// This output must not be made publicly available without access protection.
const entries = await getCollection("bookmarks", ({ id }) =>
  id !== "_index" && !id.endsWith("/_index")
);
const existing = entries.map(({ id, data }) => {
  let url = "";
  if (!data.draft) {
    try { url = parseBookmarkUrl(data.link ?? ""); }
    catch { /* Existing malformed links must not become client links. */ }
  }
  return { id, url };
});
---
<AdminLayout>
  <NewBookmark existing={existing} client:load />
</AdminLayout>
